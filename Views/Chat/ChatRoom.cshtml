@using JewelryStore.Models
@model ChatModel

<div id="RefreshArea">
    @{ Html.RenderPartial("History", Model); }
</div>

@Ajax.ActionLink("ActionLink", "Index", "Chat",
    new { user = "", logOn = "", logOff = "", chatMessage = "" },
    new AjaxOptions { UpdateTargetId = "RefreshArea", OnSuccess = "ChatOnSuccess", OnFailure = "ChatOnFailure" },
    new { @id = "ActionLink", @style = "visibility:hidden;" })

<div id="inputForm">
    <table>
        <tr>
            <td><textarea id="txtMessage" rows="2" placeholder="Введіть повідомлення..."></textarea></td>
            <td>
                <button id="btnMessage">Надіслати</button><br />
                <button id="btnLogOff">Вийти</button>
            </td>
        </tr>
    </table>
</div>