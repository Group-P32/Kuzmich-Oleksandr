@model IEnumerable<JewelryStore.Models.Category>
@{
    ViewBag.Title = "Категорії";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Категорії прикрас</h2>

<p>@Html.ActionLink("Додати категорію", "Create")</p>

<table class="jewelry-table">
    <tr>
        <th>Назва</th>
        <th>Опис</th>
        <th>Дії</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(m => item.Name)</td>
            <td>@Html.DisplayFor(m => item.Description)</td>
            <td>
                @Html.ActionLink("Редагувати", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Деталі", "Details", new { id = item.Id }) |
                @Html.ActionLink("Видалити", "Delete", new { id = item.Id })
            </td>
        </tr>
    }
</table>