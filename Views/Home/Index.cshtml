@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Ювелірний магазин";
}

<div class="jumbotron">
    <h1>Ювелірний магазин</h1>
    <p>Вишукані прикраси з золота, срібла та коштовного каміння</p>
    <p>@Html.ActionLink("Переглянути каталог", "Index", "Jewelry")</p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Каталог прикрас</h2>
        <p>Перегляньте наш широкий асортимент ювелірних виробів.</p>
        <p>@Html.ActionLink("Каталог →", "Index", "Jewelry")</p>
    </div>
    <div class="col-md-4">
        <h2>Категорії</h2>
        <p>Каблучки, намисто, браслети, сережки та багато іншого.</p>
        <p>@Html.ActionLink("Категорії →", "Index", "Category")</p>
    </div>
    <div class="col-md-4">
        <h2>Придбати</h2>
        <p>Оберіть прикрасу та оформіть замовлення.</p>
        <p>@Html.ActionLink("Замовити →", "Index", "Jewelry")</p>
    </div>
</div>

<hr />

<div class="search-section">
    <h2>Пошук прикрас</h2>
    <p>Введіть назву прикраси або матеріал для пошуку</p>

    @using (Ajax.BeginForm("JewelrySearch", "Home", new AjaxOptions
    {
        UpdateTargetId = "search-results",
        InsertionMode = InsertionMode.Replace,
        HttpMethod = "POST",
        LoadingElementId = "search-loading"
    }))
    {
        <div class="search-box">
            <input type="text" name="query" class="search-input"
                   placeholder="Наприклад: Золото, Срібло, Каблучка..." />
            <input type="submit" value="Шукати" class="search-btn" />
        </div>
    }

    <div id="search-loading" style="display:none;">
        <p>Пошук...</p>
    </div>

    <div id="search-results"></div>
</div>

@section Scripts {
    <script src="~/Scripts/jquery-1.8.0.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
}