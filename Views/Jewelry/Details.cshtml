@model JewelryStore.Models.Jewelry
@{
    ViewBag.Title = "Деталі прикраси";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Деталі прикраси</h2>

<div class="details-card">
    <table class="jewelry-table">
        <tr>
            <th>Назва</th>
            <td>@Html.DisplayFor(m => m.Name)</td>
        </tr>
        <tr>
            <th>Матеріал</th>
            <td>@Html.DisplayFor(m => m.Material)</td>
        </tr>
        <tr>
            <th>Ціна (грн)</th>
            <td>@Html.DisplayFor(m => m.Price)</td>
        </tr>
        <tr>
            <th>Категорія</th>
            <td>@Html.DisplayFor(m => m.Category.Name)</td>
        </tr>
    </table>
</div>

<br />
<p>
    @Html.ActionLink("Редагувати", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Повернутися до каталогу", "Index")
</p>