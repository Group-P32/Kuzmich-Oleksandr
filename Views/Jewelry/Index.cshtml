@model JewelryStore.Models.JewelryIndexViewModel
@using Kuzmich_JewelryStore.Helpers
@{
    ViewBag.Title = "Каталог прикрас";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Каталог прикрас</h2>

<p>
    @Html.ActionLink("Додати прикрасу", "Create") |
    @Html.ActionLink("Категорії", "Index", "Category")
</p>

<form method="get">
    <div>
        <label>Категорія:</label>
        @Html.DropDownList("category", ViewBag.CategoryId as SelectList)

        <label>Матеріал:</label>
        @Html.DropDownList("material", ViewBag.Materials as SelectList)

        <input type="submit" value="Фільтрувати" />
    </div>
</form>

<br />

<table class="jewelry-table">
    <tr>
        <th>Назва</th>
        <th>Матеріал</th>
        <th>Ціна (грн)</th>
        <th>Категорія</th>
        <th>Дії</th>
    </tr>
    @foreach (var item in Model.Jewelries)
    {
        <tr>
            <td>@Html.DisplayFor(m => item.Name)</td>
            <td>@Html.DisplayFor(m => item.Material)</td>
            <td>@Html.DisplayFor(m => item.Price)</td>
            <td>@Html.DisplayFor(m => item.Category.Name)</td>
            <td>
                @Html.ActionLink("Купити", "Buy", "Home", new { id = item.Id }, null) |
                @Html.ActionLink("Деталі", "Details", new { id = item.Id }) |
                @Html.ActionLink("Редагувати", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Видалити", "Delete", new { id = item.Id })
            </td>
        </tr>
    }
</table>

<br />
<div class="btn-group">
    @Html.PageLinks(Model.PageInfo, x => Url.Action("Index", new {
        page = x,
        category = Model.CategoryId,
        material = Model.Material
    }))
</div>