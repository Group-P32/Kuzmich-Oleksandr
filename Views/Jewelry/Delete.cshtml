@model JewelryStore.Models.Jewelry
@{
    ViewBag.Title = "Видалення прикраси";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Видалення прикраси</h2>

<p>Ви впевнені, що хочете видалити цю прикрасу?</p>

<div>
    <dl>
        <dt>Назва</dt>
        <dd>@Html.DisplayFor(m => m.Name)</dd>

        <dt>Матеріал</dt>
        <dd>@Html.DisplayFor(m => m.Material)</dd>

        <dt>Ціна (грн)</dt>
        <dd>@Html.DisplayFor(m => m.Price)</dd>

        <dt>Категорія</dt>
        <dd>@Html.DisplayFor(m => m.Category.Name)</dd>
    </dl>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Так, видалити" />
    @Html.ActionLink("Скасувати", "Index")
}