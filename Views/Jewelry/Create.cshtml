@model JewelryStore.Models.Jewelry
@{
    ViewBag.Title = "Додати прикрасу";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Додати прикрасу</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <fieldset>
        <legend>Прикраса</legend>
        <p>
            Назва прикраси<br />
            @Html.EditorFor(m => m.Name)
            @Html.ValidationMessageFor(m => m.Name)
        </p>
        <p>
            Матеріал<br />
            @Html.EditorFor(m => m.Material)
            @Html.ValidationMessageFor(m => m.Material)
        </p>
        <p>
            Ціна (грн)<br />
            @Html.EditorFor(m => m.Price)
        </p>
        <p>
            Категорія<br />
            @Html.DropDownList("CategoryId", ViewBag.CategoryId as SelectList, "-- Оберіть категорію --")
        </p>
        <p>
            <input type="submit" value="Додати" />
        </p>
    </fieldset>
}

<div>
    @Html.ActionLink("Повернутися до каталогу", "Index")
</div>