@model JewelryStore.Models.Jewelry
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Додати прикрасу";
}

<h2>Додати нову прикрасу</h2>

@using (Html.BeginForm())
{
    <p>
        @Html.LabelFor(m => m.Name, "Назва")
        <br />
        @Html.EditorFor(m => m.Name)
    </p>
    <p>
        @Html.LabelFor(m => m.Type, "Тип")
        <br />
        @Html.EditorFor(m => m.Type)
    </p>
    <p>
        @Html.LabelFor(m => m.Material, "Матеріал")
        <br />
        @Html.EditorFor(m => m.Material)
    </p>
    <p>
        @Html.LabelFor(m => m.Weight, "Вага (г)")
        <br />
        @Html.EditorFor(m => m.Weight)
    </p>
    <p>
        @Html.LabelFor(m => m.Price, "Ціна (грн)")
        <br />
        @Html.EditorFor(m => m.Price)
    </p>
    <p><input type="submit" value="Додати" /></p>
}
@Html.ActionLink("Назад до списку", "Index")