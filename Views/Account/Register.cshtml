@model JewelryStore.Models.RegisterModel
@{
    ViewBag.Title = "Реєстрація";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="auth-form">
        <h2 style="color:#f0d080; letter-spacing:3px; text-transform:uppercase; font-size:20px; margin-bottom:30px; text-align:center;">Реєстрація</h2>
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <div class="form-group">
            <label>Email</label>
            @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @class = "form-input" } })
        </div>
        <div class="form-group">
            <label>Рік народження</label>
            @Html.EditorFor(m => m.Year, new { htmlAttributes = new { @class = "form-input" } })
        </div>
        <div class="form-group">
            <label>Пароль</label>
            @Html.EditorFor(m => m.Password, new { htmlAttributes = new { @class = "form-input" } })
        </div>
        <div class="form-group">
            <label>Повторіть пароль</label>
            @Html.EditorFor(m => m.PasswordConfirm, new { htmlAttributes = new { @class = "form-input" } })
        </div>
        <div class="form-group">
            <input type="submit" value="Зареєструватися" class="auth-btn" />
        </div>
        <p>Вже маєте акаунт? @Html.ActionLink("Увійти", "Login")</p>
    </div>
}