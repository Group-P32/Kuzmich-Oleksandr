@model JewelryStore.Models.LoginModel
@{
    ViewBag.Title = "Вхід";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="auth-form">
        <h2 style="color:#f0d080; letter-spacing:3px; text-transform:uppercase; font-size:20px; margin-bottom:30px; text-align:center;">Авторизація</h2>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <input type="hidden" name="returnUrl" value="@ViewBag.returnUrl" />
        <div class="form-group">
            <label>Email</label>
            @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @class = "form-input" } })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <label>Пароль</label>
            @Html.EditorFor(m => m.Password, new { htmlAttributes = new { @class = "form-input" } })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <button type="submit" class="auth-btn">Увійти</button>
        </div>
        <p>Немає акаунту? @Html.ActionLink("Зареєструватися", "Register")</p>
    </div>
}